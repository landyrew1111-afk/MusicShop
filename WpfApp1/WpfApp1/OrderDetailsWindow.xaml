<Window x:Class="WpfApp1.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="560" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50">
            <TextBlock x:Name="txtTitle"
                       Text="О заказе"
                       Foreground="White" FontFamily="Times New Roman"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="15,10,15,5">
            <TextBlock Text="Статус:" FontFamily="Times New Roman" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="cmbStatus" Width="220" Height="30"
                      FontFamily="Times New Roman" FontSize="14"/>
            <Button x:Name="btnChangeStatus" Content="Сменить статус"
                    Width="150" Height="30"
                    Style="{StaticResource PrimaryButton}"
                    Margin="10,0,0,0" Click="BtnChangeStatus_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgItems" Grid.Row="2"
                  Margin="15,5,15,10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Naimenovanie}" Width="*"/>
                <DataGridTextColumn Header="Кол-во"       Binding="{Binding Kolichestvo}"  Width="80"/>
                <DataGridTextColumn Header="Цена"         Binding="{Binding TsenaText}"    Width="110"/>
                <DataGridTextColumn Header="Сумма"        Binding="{Binding SummaText}"    Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="15,10,15,10">
            <Button x:Name="btnClose" Content="Закрыть" Width="130" Height="34"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>