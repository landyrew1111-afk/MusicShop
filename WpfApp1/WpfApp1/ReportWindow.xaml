<Window x:Class="WpfApp1.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50">
            <TextBlock Text="Отчёт: Остатки на складе"
                       Foreground="White" FontFamily="Times New Roman"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,10,20,10">
            <TextBlock x:Name="txtDate" FontFamily="Times New Roman" FontSize="13"
                       HorizontalAlignment="Left"/>
            <TextBlock Text="Музыкальный магазин" FontFamily="Times New Roman"
                       FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <DataGrid x:Name="dgReport" Grid.Row="2"
                  Margin="20,0,20,10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№"            Binding="{Binding KodTovara}"    Width="50"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Naimenovanie}" Width="*"/>
                <DataGridTextColumn Header="Исполнитель"  Binding="{Binding Ispolnitel}"   Width="150"/>
                <DataGridTextColumn Header="Категория"    Binding="{Binding Kategoriya}"   Width="150"/>
                <DataGridTextColumn Header="Цена, руб."   Binding="{Binding TsenaText}"    Width="110"/>
                <DataGridTextColumn Header="Остаток"      Binding="{Binding Ostatki}"      Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="20,10,20,10">
            <Button x:Name="btnPrint" Content="Печать" Width="130" Height="34"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="BtnPrint_Click"/>
            <Button x:Name="btnClose" Content="Закрыть" Width="130" Height="34"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>