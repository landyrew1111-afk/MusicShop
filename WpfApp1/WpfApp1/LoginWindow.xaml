<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="400" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50">
            <TextBlock Text="Авторизация"
                       Foreground="White" FontFamily="Times New Roman"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="40,30,40,20" VerticalAlignment="Top">
            <TextBlock Text="Логин:" FontFamily="Times New Roman" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLogin" Height="32" Margin="0,0,0,15"/>

            <TextBlock Text="Пароль:" FontFamily="Times New Roman" FontSize="14" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="32" Margin="0,0,0,25"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnLogin" Content="Войти" Width="130" Height="40"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,15,0" Click="BtnLogin_Click"/>
                <Button x:Name="btnRegister" Content="Регистрация" Width="130" Height="40"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnRegister_Click"/>
            </StackPanel>

            <TextBlock x:Name="txtStatus" Text=""
                       FontFamily="Times New Roman" FontSize="12"
                       Foreground="#E74C3C"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>