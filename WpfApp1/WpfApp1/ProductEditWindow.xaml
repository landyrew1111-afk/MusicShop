<Window x:Class="WpfApp1.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="650" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50">
            <TextBlock x:Name="txtTitle" Text="Товар"
                       Foreground="White" FontFamily="Times New Roman"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="40,20,40,20">

            <TextBlock Text="Наименование:" FontFamily="Times New Roman" FontSize="13" Margin="0,0,0,3"/>
            <TextBox x:Name="txtNaimenovanie" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Исполнитель:" FontFamily="Times New Roman" FontSize="13" Margin="0,0,0,3"/>
            <TextBox x:Name="txtIspolnitel" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Категория:" FontFamily="Times New Roman" FontSize="13" Margin="0,0,0,3"/>
            <ComboBox x:Name="cmbKategoriya" Height="28" Margin="0,0,0,10"
                      FontFamily="Times New Roman" FontSize="14"/>

            <TextBlock Text="Жанр:" FontFamily="Times New Roman" FontSize="13" Margin="0,0,0,3"/>
            <TextBox x:Name="txtZhanr" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Год выпуска:" FontFamily="Times New Roman" FontSize="13" Margin="0,0,0,3"/>
            <TextBox x:Name="txtGod" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Цена розничная:" FontFamily="Times New Roman" FontSize="13" Margin="0,0,0,3"/>
            <TextBox x:Name="txtTsenaRozn" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Цена оптовая:" FontFamily="Times New Roman" FontSize="13" Margin="0,0,0,3"/>
            <TextBox x:Name="txtTsenaOpt" Height="28" Margin="0,0,0,10"/>

            <TextBlock Text="Остаток:" FontFamily="Times New Roman" FontSize="13" Margin="0,0,0,3"/>
            <TextBox x:Name="txtOstatok" Height="28" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="btnSave" Content="Сохранить" Width="140" Height="40"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,15,0" Click="BtnSave_Click"/>
                <Button x:Name="btnCancel" Content="Отмена" Width="130" Height="40"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnCancel_Click"/>
            </StackPanel>

            <TextBlock x:Name="txtStatus" Text=""
                       FontFamily="Times New Roman" FontSize="12"
                       Foreground="#E74C3C"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>