<Window x:Class="WpfApp1.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50">
            <TextBlock Text="Музыкальный магазин - Каталог товаров"
                       Foreground="White" FontFamily="Times New Roman"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1" Margin="15,10,15,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="txtSearch" Grid.Column="0"
                     Height="34" VerticalAlignment="Center"/>

            <Button x:Name="btnSearch" Grid.Column="1"
                    Content="Найти" Width="120" Height="34"
                    Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnSearch_Click"/>
        </Grid>

        <DataGrid x:Name="dgProducts" Grid.Row="2"
                  Margin="15,0,15,10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Naimenovanie}" Width="*"/>
                <DataGridTextColumn Header="Исполнитель"  Binding="{Binding Ispolnitel}"   Width="180"/>
                <DataGridTextColumn Header="Категория"    Binding="{Binding Kategoriya}"   Width="150"/>
                <DataGridTextColumn Header="Жанр"         Binding="{Binding Zhanr}"        Width="120"/>
                <DataGridTextColumn Header="Цена, руб."   Binding="{Binding TsenaText}"    Width="120"/>
                <DataGridTextColumn Header="Остаток"      Binding="{Binding Ostatki}"      Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="15,10,15,10">
            <Button x:Name="btnNewOrder" Content="Оформить заказ" Width="170" Height="40"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="BtnNewOrder_Click"/>
            <Button x:Name="btnOrders" Content="Заказы" Width="130" Height="40"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" Click="BtnOrders_Click"/>
            <Button x:Name="btnAdd"     Content="Добавить" Width="130" Height="40"
                    Style="{StaticResource PrimaryButton}"   Margin="0,0,10,0" Click="BtnAdd_Click"/>
            <Button x:Name="btnEdit"    Content="Изменить" Width="130" Height="40"
                    Style="{StaticResource PrimaryButton}"   Margin="0,0,10,0" Click="BtnEdit_Click"/>
            <Button x:Name="btnDelete"  Content="Удалить"  Width="130" Height="40"
                    Style="{StaticResource DangerButton}"    Margin="0,0,10,0" Click="BtnDelete_Click"/>
            <Button x:Name="btnRefresh" Content="Обновить" Width="130" Height="40"
                    Style="{StaticResource SecondaryButton}" Click="BtnRefresh_Click"/>
            <Button x:Name="btnReport" Content="Отчёт" Width="130" Height="40"
                    Style="{StaticResource SecondaryButton}"
                    Margin="10,0,0,0" Click="BtnReport_Click"/>
        </StackPanel>

        <Border Grid.Row="4" Background="#DCDCDC">
            <Grid Margin="15,0">
                <TextBlock x:Name="txtUserInfo"
                           FontFamily="Times New Roman" FontSize="12"
                           Foreground="#2C3E50"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock x:Name="txtCount"
                           FontFamily="Times New Roman" FontSize="12"
                           Foreground="#2C3E50"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>