<Window x:Class="WpfApp1.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50">
            <TextBlock Text="Заказы"
                       Foreground="White" FontFamily="Times New Roman"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="15,10,15,10">
            <TextBlock Text="Статус:" FontFamily="Times New Roman" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox x:Name="cmbStatus" Width="180" Height="30"
                      FontFamily="Times New Roman" FontSize="14"
                      SelectedIndex="0">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="Новый"/>
                <ComboBoxItem Content="В обработке"/>
                <ComboBoxItem Content="Готов к выдаче"/>
                <ComboBoxItem Content="Передан в доставку"/>
                <ComboBoxItem Content="Закрыт"/>
                <ComboBoxItem Content="Отменён"/>
            </ComboBox>

            <Button x:Name="btnApply" Content="Показать" Width="130" Height="34"
                    Style="{StaticResource PrimaryButton}"
                    Margin="15,0,0,0" Click="BtnApply_Click"/>

            <Button x:Name="btnDetails" Content="О заказе" Width="130" Height="34"
                    Style="{StaticResource SecondaryButton}"
                    Margin="15,0,0,0" Click="BtnDetails_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgOrders" Grid.Row="2"
                  Margin="15,0,15,10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№"              Binding="{Binding KodZakaza}"      Width="60"/>
                <DataGridTextColumn Header="Клиент"         Binding="{Binding Klient}"         Width="*"/>
                <DataGridTextColumn Header="Дата"           Binding="{Binding DataText}"       Width="150"/>
                <DataGridTextColumn Header="Статус"         Binding="{Binding Status}"         Width="150"/>
                <DataGridTextColumn Header="Способ"         Binding="{Binding SposobDostavki}" Width="150"/>
                <DataGridTextColumn Header="Сотрудник"      Binding="{Binding Sotrudnik}"      Width="150"/>
                <DataGridTextColumn Header="Сумма"          Binding="{Binding SummaText}"      Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#DCDCDC">
            <TextBlock x:Name="txtCount"
                       FontFamily="Times New Roman" FontSize="12"
                       Foreground="#2C3E50"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="0,0,15,0"/>
        </Border>
    </Grid>
</Window>