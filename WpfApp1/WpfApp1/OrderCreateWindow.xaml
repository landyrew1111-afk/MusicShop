<Window x:Class="WpfApp1.OrderCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50">
            <TextBlock Text="Музыкальный магазин - Оформление заказа"
                       Foreground="White" FontFamily="Times New Roman"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Каталог товаров" FontFamily="Times New Roman"
                           FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox x:Name="txtSearch" Width="250" Height="28" Margin="0,0,8,0"/>
                    <Button x:Name="btnSearch" Content="Найти" Width="90" Height="28"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnSearch_Click"/>
                </StackPanel>

                <DataGrid x:Name="dgCatalog" Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Naimenovanie}" Width="*"/>
                        <DataGridTextColumn Header="Цена"         Binding="{Binding TsenaText}"    Width="90"/>
                        <DataGridTextColumn Header="Остаток"      Binding="{Binding Ostatki}"      Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <Button x:Name="btnAddToCart" Content="→" Width="52" Height="45"
                        FontSize="20" FontWeight="Bold"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,0,10" Click="BtnAddToCart_Click"/>
                <Button x:Name="btnRemove" Content="←" Width="52" Height="45"
                        FontSize="20" FontWeight="Bold"
                        Style="{StaticResource DangerButton}"
                        Click="BtnRemove_Click"/>
            </StackPanel>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Корзина" FontFamily="Times New Roman"
                           FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>

                <DataGrid x:Name="dgCart" Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Naimenovanie}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во"       Binding="{Binding Kolichestvo}"  Width="70"/>
                        <DataGridTextColumn Header="Цена"         Binding="{Binding TsenaText}"    Width="90"/>
                        <DataGridTextColumn Header="Сумма"        Binding="{Binding SummaText}"    Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Margin="15,5,15,5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Способ получения:" FontFamily="Times New Roman"
                           FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="cmbDelivery" Width="220" Height="30"
                          FontFamily="Times New Roman" FontSize="14"
                          SelectedIndex="0">
                    <ComboBoxItem Content="Самовывоз"/>
                    <ComboBoxItem Content="Курьерская доставка"/>
                    <ComboBoxItem Content="Почта России"/>
                    <ComboBoxItem Content="Транспортная компания"/>
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="txtTotal" Text="Итого: 0,00 руб."
                       FontFamily="Times New Roman" FontSize="16" FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Right" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Left" Margin="15,10,15,10">
            <Button x:Name="btnSave" Content="Сохранить заказ" Width="180" Height="40"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="130" Height="40"
                    Style="{StaticResource SecondaryButton}"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>